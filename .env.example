# =============================================================================
# Marketplace de Repuestos Automotrices - Variables de entorno (ejemplo)
# =============================================================================
# COMO USAR ESTE ARCHIVO:
#   1. Copia este archivo y renombralo a `.env` en la raiz del repositorio
#   2. Ajusta los valores si lo necesitas
#   3. NUNCA subas el archivo `.env` real a Git (esta en .gitignore)
#
# REGLA DEL EQUIPO: si agregas una variable nueva, agregala AQUI primero.
# El `.env.example` documenta la configuracion sin revelar secretos reales.
# =============================================================================

# -----------------------------------------------------------------------------
# RABBITMQ - Mensajeria entre microservicios
# -----------------------------------------------------------------------------
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# -----------------------------------------------------------------------------
# JWT - Autenticacion
# -----------------------------------------------------------------------------
# El API Gateway valida el token y lo descompone en headers (X-User-Id, X-User-Roles).
# Cada microservicio DEBE validar la firma por su cuenta con este mismo secreto.
JWT_SECRET=cambia-este-secreto-en-produccion-min-32-caracteres
JWT_EXPIRES_IN=3600

# -----------------------------------------------------------------------------
# IDENTITY SERVICE (Django) - puerto 5000
# -----------------------------------------------------------------------------
DB_IDENTITY_NAME=identity_db
DB_IDENTITY_USER=identity_user
DB_IDENTITY_PASSWORD=identity_pass
DB_IDENTITY_HOST=localhost
DB_IDENTITY_PORT=5433
IDENTITY_PORT=5000
# Django levanta un secreto propio, no reutilizar el JWT_SECRET
DJANGO_SECRET_KEY=cambia-este-django-secret-key-en-produccion

# -----------------------------------------------------------------------------
# PART REQUEST SERVICE (Express) - puerto 4001
# -----------------------------------------------------------------------------
DB_PART_REQUEST_NAME=part_request_db
DB_PART_REQUEST_USER=part_request_user
DB_PART_REQUEST_PASSWORD=part_request_pass
DB_PART_REQUEST_HOST=localhost
DB_PART_REQUEST_PORT=5434
PART_REQUEST_PORT=4001

# -----------------------------------------------------------------------------
# OFFER SERVICE (Express) - puerto 4002
# -----------------------------------------------------------------------------
DB_OFFER_NAME=offer_db
DB_OFFER_USER=offer_user
DB_OFFER_PASSWORD=offer_pass
DB_OFFER_HOST=localhost
DB_OFFER_PORT=5435
OFFER_PORT=4002

# -----------------------------------------------------------------------------
# ORDER SERVICE (Express) - puerto 4003
# -----------------------------------------------------------------------------
DB_ORDER_NAME=order_db
DB_ORDER_USER=order_user
DB_ORDER_PASSWORD=order_pass
DB_ORDER_HOST=localhost
DB_ORDER_PORT=5436
ORDER_PORT=4003

# -----------------------------------------------------------------------------
# CATALOG / VEHICLE SERVICE (Express) - puerto 4004
# -----------------------------------------------------------------------------
DB_CATALOG_NAME=catalog_db
DB_CATALOG_USER=catalog_user
DB_CATALOG_PASSWORD=catalog_pass
DB_CATALOG_HOST=localhost
DB_CATALOG_PORT=5437
CATALOG_PORT=4004

# -----------------------------------------------------------------------------
# NOTIFICATION SERVICE (Express) - puerto 4005
# -----------------------------------------------------------------------------
DB_NOTIFICATION_NAME=notification_db
DB_NOTIFICATION_USER=notification_user
DB_NOTIFICATION_PASSWORD=notification_pass
DB_NOTIFICATION_HOST=localhost
DB_NOTIFICATION_PORT=5438
NOTIFICATION_PORT=4005

# -----------------------------------------------------------------------------
# API GATEWAY - puerto 4000 (punto de entrada unico)
# -----------------------------------------------------------------------------
API_GATEWAY_PORT=4000
IDENTITY_SERVICE_URL=http://localhost:5000
PART_REQUEST_SERVICE_URL=http://localhost:4001
OFFER_SERVICE_URL=http://localhost:4002
ORDER_SERVICE_URL=http://localhost:4003
CATALOG_SERVICE_URL=http://localhost:4004
NOTIFICATION_SERVICE_URL=http://localhost:4005

# -----------------------------------------------------------------------------
# FRONTEND (Angular) - puerto 4200
# -----------------------------------------------------------------------------
FRONTEND_PORT=4200
# El frontend SIEMPRE habla con el Gateway, nunca con un microservicio directo
VITE_API_BASE_URL=http://localhost:4000

# -----------------------------------------------------------------------------
# SMTP - Correos de notificacion (opcional, solo si se implementa)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
