# =============================================================================
# RepuestosYa - Variables de entorno (ejemplo)
# =============================================================================
# COMO USAR ESTE ARCHIVO:
#   1. Copia este archivo y renombralo a `.env` en la raiz del repositorio
#   2. Ajusta los valores si lo necesitas
#   3. NUNCA subas el archivo `.env` real a Git (esta en .gitignore)
#
# REGLA DEL EQUIPO: si agregas una variable nueva, agregala AQUI primero.
# =============================================================================

# -----------------------------------------------------------------------------
# RABBITMQ - Mensajeria entre microservicios
# -----------------------------------------------------------------------------
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# -----------------------------------------------------------------------------
# JWT - Autenticacion
# -----------------------------------------------------------------------------
# Identidad lo emite (SimpleJWT, HS256). Cada microservicio DEBE validar la
# firma por su cuenta con este mismo secreto, ademas de lo que valide el Gateway.
JWT_SECRET=cambia-este-secreto-en-produccion-min-32-caracteres
JWT_EXPIRES_IN=3600

# -----------------------------------------------------------------------------
# IDENTIDAD (Django)
# -----------------------------------------------------------------------------
# false por defecto: con true, Django responde con su página de debug interna
# (stack trace y settings) ante cualquier error que no pase por DRF.
# Ponlo en true SOLO para desarrollo local si necesitas esa página.
IDENTITY_DEBUG=false

# -----------------------------------------------------------------------------
# POSTGRES - Un solo servidor, un esquema y un usuario por servicio
# -----------------------------------------------------------------------------
# infra/postgres/init.sql crea la base, los 5 esquemas y los 5 usuarios.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=repuestosya
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=cambia-esta-password-admin

DB_IDENTIDAD_USER=identidad_user
DB_IDENTIDAD_PASSWORD=identidad_pass

DB_NEGOCIACION_USER=negociacion_user
DB_NEGOCIACION_PASSWORD=negociacion_pass

DB_PEDIDOS_USER=pedidos_user
DB_PEDIDOS_PASSWORD=pedidos_pass

DB_CATALOGO_USER=catalogo_user
DB_CATALOGO_PASSWORD=catalogo_pass

DB_NOTIFICACIONES_USER=notificaciones_user
DB_NOTIFICACIONES_PASSWORD=notificaciones_pass

# -----------------------------------------------------------------------------
# IDENTIDAD (Django) - puerto 5000
# -----------------------------------------------------------------------------
IDENTIDAD_PORT=5000
# Django levanta un secreto propio, no reutilizar el JWT_SECRET
DJANGO_SECRET_KEY=cambia-este-django-secret-key-en-produccion
# Hosts que Django acepta. Dentro de Docker el contenedor se llama `identidad`
# y el Gateway lo llama por ese nombre.
IDENTITY_ALLOWED_HOSTS=localhost,127.0.0.1,identidad
# Admin creado al iniciar si no existe (docker-entrypoint.sh)
ADMIN_EMAIL=admin@repuestosya.com
ADMIN_PASSWORD=cambia-esta-password-admin-inicial

# -----------------------------------------------------------------------------
# NEGOCIACION (Express) - puerto 4001
# -----------------------------------------------------------------------------
NEGOCIACION_PORT=4001

# -----------------------------------------------------------------------------
# PEDIDOS (Spring Boot) - puerto 4003
# -----------------------------------------------------------------------------
PEDIDOS_PORT=4003

# -----------------------------------------------------------------------------
# CATALOGO (NestJS) - puerto 4004
# -----------------------------------------------------------------------------
CATALOGO_PORT=4004

# -----------------------------------------------------------------------------
# NOTIFICACIONES (Express) - puerto 4005
# -----------------------------------------------------------------------------
NOTIFICACIONES_PORT=4005

# -----------------------------------------------------------------------------
# GATEWAY - puerto 4000 (punto de entrada unico, expuesto)
# -----------------------------------------------------------------------------
GATEWAY_PORT=4000
# CORS: origen (y SOLO ese) permitido para el frontend
FRONTEND_ORIGIN=http://localhost:4200
# URLs internas por nombre de contenedor (dentro de Docker, nunca localhost)
IDENTIDAD_SERVICE_URL=http://identidad:5000
NEGOCIACION_SERVICE_URL=http://negociacion:4001
PEDIDOS_SERVICE_URL=http://pedidos:4003
CATALOGO_SERVICE_URL=http://catalogo:4004
NOTIFICACIONES_SERVICE_URL=http://notificaciones:4005

# -----------------------------------------------------------------------------
# FRONTEND (Angular) - puerto 4200 (expuesto)
# -----------------------------------------------------------------------------
FRONTEND_PORT=4200
# El frontend SIEMPRE habla con el Gateway, nunca con un microservicio directo
API_BASE_URL=http://localhost:4000
