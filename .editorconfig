# EditorConfig ayuda a que los archivos se vean igual en todos los editores
# y para todos los integrantes, sin importar el agente de IA que usen.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,ts,json,yml,yaml,html,css,scss}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
